<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>dev.jharness</groupId>
    <artifactId>jharness-parent</artifactId>
    <version>0.1.0</version>
  </parent>
  <artifactId>jharness-testkit</artifactId>
  <name>JHarness testkit</name>

  <dependencies>
    <dependency><groupId>dev.jharness</groupId><artifactId>jharness-sandbox</artifactId></dependency>
    <dependency><groupId>dev.jharness</groupId><artifactId>jharness-llm</artifactId></dependency>
    <dependency><groupId>dev.jharness</groupId><artifactId>jharness-agent</artifactId></dependency>
  </dependencies>

  <profiles>
    <!-- mvn -Pnative -pl jharness-testkit -am package -DskipTests: the native smoke binary (AC-14). -->
    <profile>
      <id>native</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
            <extensions>true</extensions>
            <executions>
              <execution>
                <id>build-native</id>
                <goals>
                  <goal>compile-no-fork</goal>
                </goals>
                <phase>package</phase>
              </execution>
            </executions>
            <configuration>
              <imageName>jharness-smoke</imageName>
              <mainClass>dev.jharness.testkit.Smoke</mainClass>
              <buildArgs>
                <buildArg>--no-fallback</buildArg>
                <!-- The JDK HTTP client needs these URL handlers to reach the egress proxy (spec 011). -->
                <buildArg>--enable-url-protocols=http,https</buildArg>
                <buildArg>--enable-native-access=ALL-UNNAMED,org.graalvm.truffle</buildArg>
              </buildArgs>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
