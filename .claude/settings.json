{
  "extraKnownMarketplaces": {
    "claude-basics": {
      "source": {
        "source": "github",
        "repo": "canmogol/claude-basics"
      }
    }
  },
  "enabledPlugins": {
    "p-spec@claude-basics": true
  },
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Bash(git push origin master*)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:master*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  }
}
